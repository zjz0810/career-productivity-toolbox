.list-head { padding: 12rpx 4rpx 24rpx; }.list-title { color: #1d2228; font-size: 42rpx; font-weight: 700; }.list-subtitle { margin-top: 10rpx; color: #8a919d; font-size: 23rpx; }.result-count { margin: 0 4rpx 14rpx; color: #8a919d; font-size: 22rpx; }
.subcategory-list { display: grid; gap: 10rpx; margin-bottom: 25rpx; }.subcategory-item { display: flex; align-items: center; padding: 18rpx 20rpx; }.subcategory-copy { flex: 1; }.subcategory-name { color: #2b3037; font-size: 27rpx; font-weight: 600; }.subcategory-desc { margin-top: 6rpx; color: #969da7; font-size: 21rpx; }.subcategory-count { color: #69727e; font-size: 22rpx; }.subcategory-count text { margin-left: 10rpx; color: #a4abb5; font-size: 32rpx; }.section-label { margin: 0 4rpx 12rpx; color: #4d5662; font-size: 25rpx; font-weight: 600; }
.question-card { margin-bottom: 16rpx; padding: 22rpx 20rpx 16rpx; }.question-card-top { display: flex; align-items: flex-start; }.question-index { width: 78rpx; padding-top: 4rpx; color: #aab0b9; font-size: 23rpx; }.question-card-body { flex: 1; }.question-text { color: #292e35; font-size: 29rpx; line-height: 1.55; }.tag-line { margin-top: 12rpx; }.tag-line .tag { margin-bottom: 0; }.state-line { margin-top: 16rpx; padding-top: 13rpx; border-top: 1rpx solid #f0f1f3; }.state { display: inline-block; margin-right: 12rpx; padding: 4rpx 10rpx; border-radius: 5rpx; font-size: 20rpx; }.favorite-state { background: #fff6dd; color: #aa7a11; }.mastered-state { background: #eaf8f0; color: #37855a; }.review-state { background: #fff0e4; color: #b86c31; }.difficulty { float: right; color: #a1a8b2; font-size: 20rpx; }.study-section-title { margin: 22rpx 4rpx 12rpx; color: #4d5662; font-size: 27rpx; font-weight: 600; }.section-empty { margin-bottom: 16rpx; padding: 36rpx 20rpx; }.mastered-entry { display: flex; align-items: center; justify-content: space-between; width: 100%; margin: 24rpx 0 10rpx; padding: 22rpx 24rpx; border: 1rpx solid #cfe2d6; color: #37855a; background: #f4fbf6; font-size: 27rpx; text-align: left; }.mastered-entry text { color: #7aa88a; font-size: 38rpx; }.empty-tip { margin-top: 14rpx; color: #b0b6bf; font-size: 22rpx; }
