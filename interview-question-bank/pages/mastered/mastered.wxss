.list-head { padding: 12rpx 4rpx 24rpx; }.list-title { color: #1d2228; font-size: 42rpx; font-weight: 700; }.list-subtitle { margin-top: 10rpx; color: #8a919d; font-size: 23rpx; }.result-count { margin: 0 4rpx 14rpx; color: #8a919d; font-size: 22rpx; }
.question-card { margin-bottom: 16rpx; padding: 22rpx 20rpx 16rpx; }.question-card-top { display: flex; align-items: flex-start; }.question-index { width: 78rpx; padding-top: 4rpx; color: #aab0b9; font-size: 23rpx; }.question-card-body { flex: 1; }.question-text { color: #292e35; font-size: 29rpx; line-height: 1.55; }.tag-line { margin-top: 12rpx; }.tag-line .tag { margin-bottom: 0; }.state-line { margin-top: 16rpx; padding-top: 13rpx; border-top: 1rpx solid #f0f1f3; }.state { display: inline-block; margin-right: 12rpx; padding: 4rpx 10rpx; border-radius: 5rpx; font-size: 20rpx; }.mastered-state { background: #eaf8f0; color: #37855a; }.difficulty { float: right; color: #a1a8b2; font-size: 20rpx; }.empty-tip { margin-top: 14rpx; color: #b0b6bf; font-size: 22rpx; }
